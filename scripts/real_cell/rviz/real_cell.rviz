# The real two-beaker cell while it runs: the robot as it moves, the beakers as
# the cameras see them, the scene and path the trajectory was PLANNED for, and
# the three camera images. Started by scripts/real_cell/monitor.sh, which also
# runs monitor_node.py for the /real_cell/* topics.
#
# Objects are shown ONLY as the cameras perceive them (cho_object_pose,
# pour_beakers.yaml: beaker1 blue, beaker2 orange) -- no preset or planned
# positions are drawn. The plan appears as the grasp path it will drive, and the
# status line says how far each perceived beaker is from where it was planned.
#
# The RobotModel is the bringup's /robot_description; the images need the camera
# drivers. Fixed Frame is the FR5's base_link.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 400
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.1
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Update Interval: 0
      Frame Timeout: 5
    - Class: rviz_default_plugins/MarkerArray
      Name: Perceived (cameras)
      Enabled: true
      Namespaces:
        {}
      Topic:
        Value: /perception/object_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Pose
      Name: beaker1 pose
      Enabled: true
      Shape: Axes
      Axes Length: 0.06
      Axes Radius: 0.004
      Topic:
        Value: /perception/object_pose/held_beaker
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Pose
      Name: beaker2 pose
      Enabled: true
      Shape: Axes
      Axes Length: 0.06
      Axes Radius: 0.004
      Topic:
        Value: /perception/object_pose/beaker2
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Planned path
      Enabled: true
      Namespaces:
        {}
      Topic:
        Value: /real_cell/planned_path
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Status
      Enabled: true
      Namespaces:
        {}
      Topic:
        Value: /real_cell/status
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    # Best Effort subscribes to both the reliable and the best-effort image
    # publishers the three drivers use.
    - Class: rviz_default_plugins/Image
      Name: side_1 (OAK)
      Enabled: true
      Normalize Range: true
      Topic:
        Value: /side_1/rgb/image_rect
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: side_2 (D435)
      Enabled: true
      Normalize Range: true
      Topic:
        Value: /side_2/side_2/color/image_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: wrist (D435)
      Enabled: true
      Normalize Range: true
      Topic:
        Value: /wrist/wrist/color/image_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 1.9
      Focal Point:
        X: 0.4
        Y: 0
        Z: 0.1
      Pitch: 0.7
      Yaw: 3.4
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1700
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: ""
