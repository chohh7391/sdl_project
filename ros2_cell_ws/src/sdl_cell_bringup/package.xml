<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sdl_cell_bringup</name>
  <version>0.1.0</version>
  <description>The FR5 pour cell on the core's FR5 bringup: the pouring controller, its parameters, and the cell's robot registry.</description>
  <maintainer email="chohh7391@gmail.com">Hyunho Cho</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>cho_robot_config</build_depend>
  <build_depend>python3-yaml</build_depend>

  <exec_depend>cho_bringup_fr5</exec_depend>
  <exec_depend>cho_robot_config</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sdl_pour_controller</exec_depend>

  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>cho_task_manager</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
