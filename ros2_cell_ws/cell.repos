# The core this cell builds on, imported into the core workspace
# (README.md, Build):
#
#   vcs import --recursive src < cell.repos
#
# version is a core tag, the core the cell's tests passed on. A branch follows
# its tip, so the cell would build on whatever main is that day.
repositories:
  cho_robot_project:
    type: git
    url: https://github.com/chohh7391/cho_robot_project.git
    version: v0.1.0
